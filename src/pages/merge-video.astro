---
import Layout from '../layouts/Layout.astro';
import MergeVideoTool from '../components/MergeVideoTool';
---

<Layout title="Merge Videos - Free Online Video Joiner | YTools"
    description="Combine multiple videos into one file for free. Join MP4, WebM, AVI, MOV, and MKV clips in your browser - nothing is uploaded to a server."
    keywords="merge videos, combine videos, video joiner, join videos, merge mp4">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl md:text-4xl font-bold text-text-main mb-4 text-center">Merge Videos</h1>
    <p class="text-text-muted text-lg text-center mb-8">
      Combine multiple video clips into a single file for free. All processing happens locally in your browser - nothing is uploaded.
    </p>
    <MergeVideoTool client:only="react" />
  </div>
</Layout>
