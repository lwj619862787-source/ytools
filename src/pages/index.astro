---
import Layout from '../layouts/Layout.astro';
---

<Layout title="YTools - Free Online Video Converter & Audio Extractor" description="Free, private, in-browser video tools. Convert videos between formats and extract audio — nothing is ever uploaded to a server.">
  <div class="max-w-5xl mx-auto px-4 w-full">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-text-main mb-4">
        Video Tools, <span class="text-gradient">Private & Free</span>
      </h1>
      <p class="text-text-muted text-lg">
        Convert videos and extract audio right in your browser. All processing happens locally — your files never leave your device.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <a href="/video-converter" class="glass-panel rounded-3xl p-8 hover:border-primary-500/40 hover:shadow-lg transition-all group">
        <div class="w-14 h-14 rounded-2xl bg-primary-500/15 flex items-center justify-center text-primary-500 mb-5">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        </div>
        <h2 class="text-xl font-bold text-text-main mb-2 group-hover:text-primary-500 transition-colors">Video Converter</h2>
        <p class="text-text-muted text-sm">Convert between MP4, WebM, AVI, MOV, and GIF formats locally.</p>
      </a>

      <a href="/extract-audio" class="glass-panel rounded-3xl p-8 hover:border-primary-500/40 hover:shadow-lg transition-all group">
        <div class="w-14 h-14 rounded-2xl bg-secondary-500/15 flex items-center justify-center text-secondary-500 mb-5">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
        </div>
        <h2 class="text-xl font-bold text-text-main mb-2 group-hover:text-primary-500 transition-colors">Extract Audio</h2>
        <p class="text-text-muted text-sm">Rip MP3 audio tracks from any video file, entirely in-browser.</p>
      </a>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
      <div class="bg-base-900/40 rounded-2xl p-6 border border-black/5 dark:border-white/5">
        <h3 class="text-text-main font-bold mb-2">100% Private</h3>
        <p class="text-text-muted text-sm">Files are processed in your browser. Nothing is uploaded to our servers.</p>
      </div>
      <div class="bg-base-900/40 rounded-2xl p-6 border border-black/5 dark:border-white/5">
        <h3 class="text-text-main font-bold mb-2">No Limits</h3>
        <p class="text-text-muted text-sm">No file size caps, no watermarks, no hidden fees — ever.</p>
      </div>
      <div class="bg-base-900/40 rounded-2xl p-6 border border-black/5 dark:border-white/5">
        <h3 class="text-text-main font-bold mb-2">Blazingly Fast</h3>
        <p class="text-text-muted text-sm">Local processing means instant results, no upload wait time.</p>
      </div>
    </div>
  </div>
</Layout>
