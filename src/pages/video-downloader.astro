---
import Layout from '../layouts/Layout.astro';
import VideoDownloaderTool from '../components/VideoDownloaderTool';
---

<Layout title="Video Downloader - Free MP4 Bulk Download | YTools"
    description="Download videos from YouTube, TikTok, Instagram, Facebook and more as MP4 for free. Paste multiple links to download in bulk or pack them into a ZIP."
    keywords="video downloader, youtube downloader, youtube to mp4, tiktok downloader, instagram downloader, bulk video downloader">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl md:text-4xl font-bold text-text-main mb-4 text-center">Video Downloader</h1>
    <p class="text-text-muted text-lg text-center mb-8">
      Paste one or more video links (one per line) and force-download them as MP4 or other formats, or pack them into a ZIP. Supports YouTube, TikTok, Instagram, Facebook and more.
    </p>
    <VideoDownloaderTool client:load />

    <div class="mt-10">
      <div class="glass-panel rounded-2xl p-6 space-y-3">
        <h2 class="text-lg font-bold text-text-main">Safety &amp; Legality</h2>
        <p class="text-sm text-text-muted leading-relaxed">
          Use this tool only for content you own or have permission to download. Respect the terms of service of the source platforms and copyright laws in your region. We do not encourage downloading copyrighted content without authorization.
        </p>
      </div>
    </div>
  </div>
</Layout>
